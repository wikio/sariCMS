# Next.js storefront — copy to .env.local
# The browser always calls the relative /api/v1 prefix (rewritten below).
NEXT_PUBLIC_CMS_API_URL=/api/v1

# En production : origine HTTPS canonique pour redirections et liens dans les emails.
# PUBLIC_SITE_ORIGIN=https://votre-domaine.tld

# Server-side / rewrite target (Nest process). Do not expose this to the browser.
CMS_API_INTERNAL_URL=http://127.0.0.1:3001/api/v1

# Même adresse pour les scripts d’exploitation (menus:*, visibility:test).
# Exporter cette variable dans le shell des scripts ou passer --api.
API_URL=http://127.0.0.1:3001/api/v1

# Port de l'API : le numéro vit dans `backend/.env` (`PORT=3001`). Pour rendre 3001
# disponible et servir le CMS sur 5001, mettez `PORT=5001` dans backend/.env et les
# deux lignes ci-dessus sur 5001, puis redémarrez les deux processus. Le front reste
# sur 5000 (`npm run dev`), le navigateur ne voit que `/api/v1` : lui non plus ne
# bouge pas. Côté backend, `CORS_ORIGINS` doit continuer de le lister : http://localhost:5000.

# Clé partagée avec l'API : elle autorise POST /mail/internal/send, utilisé par
# les flux publics (contact, lettre d'information, candidatures, mot de passe
# oublié) qui n'ont pas de session administrateur. Absente ou vide, ces flux ne
# peuvent pas envoyer d'email — le centre de courrier répond
# « internal_key_missing ».
# Pour Contact, son absence ferme aussi la soumission (pas seulement le courrier).
# La MÊME valeur de MAIL_INTERNAL_KEY doit figurer dans backend/.env.
# CONTACT_AI_URL, CONTACT_AI_MODEL et CONTACT_AI_API_KEY sont réservés au backend.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_INTERNAL_KEY=
