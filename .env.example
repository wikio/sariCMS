# Next.js storefront — copy to .env.local
# The browser always calls the relative /api/v1 prefix (rewritten below).
NEXT_PUBLIC_CMS_API_URL=/api/v1

# Server-side / rewrite target (Nest process). Do not expose this to the browser.
CMS_API_INTERNAL_URL=http://127.0.0.1:3001/api/v1

# Même adresse, lue par les routages serveur qui ne passent pas par la réécriture
# Next (visibilité du site, scripts npm run menus:* / visibility:test).
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/api/v1

# Port de l'API : le numéro vit dans `backend/.env` (`PORT=3001`). Pour rendre 3001
# disponible et servir le CMS sur 5001, mettez `PORT=5001` dans backend/.env et les
# deux lignes ci-dessus sur 5001, puis redémarrez les deux processus. Le front reste
# sur 5000 (`npm run dev`), le navigateur ne voit que `/api/v1` : lui non plus ne
# bouge pas. Côté backend, `CORS_ORIGINS` doit continuer de le lister : http://localhost:5000.
