// SARI CMS — Prisma schema
// Default provider: MySQL.
// To switch to PostgreSQL without touching business code:
//   1. set provider = "postgresql"
//   2. set DATABASE_URL to a postgres:// URL
//   3. run `npx prisma generate && npx prisma migrate dev`
// The repository layer never imports Prisma models directly in services.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id    Int      @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  firstName    String    @default("")
  lastName     String    @default("")
  phone        String?
  company      String?
  avatar       String?
  type         String    @default("client") // admin | client | partner | candidate
  status       String    @default("pending") // active | blocked | pending
  locale       String    @default("fr")
  roleId    Int?
  role         Role?     @relation(fields: [roleId], references: [id])
  totpEnabled  Boolean   @default(false)
  totpSecret   String?
  partnerCode  String?
  partnerKey   String?
  address      String?   @db.Text
  wilaya       String?
  country      String?
  position     String?
  experience   String?
  motivation   String?   @db.Text
  cvUrl        String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy   Int?
  updatedBy   Int?

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]     @relation("ActorLogs")
  orders        Order[]        @relation("UserOrders")
  quotes        Quote[]        @relation("UserQuotes")
  applications  JobApplication[] @relation("UserApplications")

  @@index([type, status])
  @@index([deletedAt])
  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  updatedBy  Int?
  userAgent  String?  @db.Text
  ip         String?

  @@index([userId])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("refresh_tokens")
}

model Role {
  id    Int      @id @default(autoincrement())
  name        String
  slug        String           @unique
  description   String?          @db.Text
  isSystem      Boolean          @default(false)
  permissionIds Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  updatedBy   Int?
  users       User[]
  permissions RolePermission[]

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id    Int      @id @default(autoincrement())
  resource    String
  action      String
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  updatedBy   Int?
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId    Int
  permissionId    Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Content — group 2
// ---------------------------------------------------------------------------

model Page {
  id    Int      @id @default(autoincrement())
  slug        String
  locale      String    @default("fr")
  kind        String // legal | about | generic
  subtype     String    @default("simple") // simple | gallery | flyer | slide | scroll | full
  title       String
  subtitle    String?
  category    String?
  content     String?   @db.Text
  media       Json?
  slides      Json?
  sections    Json?
  features    Json?
  pdfUrl      String?
  status      String    @default("draft") // draft | published | archived
  publishedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([slug, locale])
  @@index([kind, subtype])
  @@index([status])
  @@index([deletedAt])
  @@map("pages")
}

model Faq {
  id    Int      @id @default(autoincrement())
  locale    String    @default("fr")
  question  String    @db.Text
  answer    String    @db.Text
  category  String?
  sortOrder Int       @default(0)
  status    String    @default("published")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@index([locale, category])
  @@index([deletedAt])
  @@map("faqs")
}

model Testimonial {
  id    Int      @id @default(autoincrement())
  locale    String    @default("fr")
  name      String
  role      String?
  clinic    String?
  text      String    @db.Text
  image     String?
  rating    Int       @default(5)
  sortOrder Int       @default(0)
  legacyId  String?
  parentId  Int?
  isDefault Boolean   @default(false)
  status    String    @default("published")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@index([locale, status])
  @@index([legacyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("testimonials")
}

model Menu {
  id    Int      @id @default(autoincrement())
  locale    String    @default("fr")
  name      String
  location  String // main | footer-nav | footer-legal | social
  items     Json
  status    String    @default("published")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([location, locale])
  @@index([deletedAt])
  @@map("menus")
}

model ContactInfo {
  id    Int      @id @default(autoincrement())
  locale    String    @default("fr")
  company   String?
  tagline   String?
  phone     String?
  email     String?
  address   String?   @db.Text
  hours     String?
  currency  String?
  logo      String?
  social    Json?
  extras    Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([locale])
  @@map("contact_info")
}

model ContactMessage {
  id    Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String    @db.Text
  status    String    @default("new") // new | read | archived
  meta      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@index([status])
  @@index([deletedAt])
  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Transverse
// ---------------------------------------------------------------------------

model Translation {
  id    Int      @id @default(autoincrement())
  entityType String
  entityId    Int
  locale     String
  field      String
  value      String    @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([entityType, entityId, locale, field])
  @@index([entityType, entityId])
  @@index([locale])
  @@map("translations")
}

model AuditLog {
  id    Int      @id @default(autoincrement())
  actorId    Int?
  actor      User?    @relation("ActorLogs", fields: [actorId], references: [id])
  action     String
  resource   String
  resourceId    Int?
  payload    Json?
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@index([resource, resourceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id    Int      @id @default(autoincrement())
  key       String    @unique
  value     Json
  group     String    @default("general")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Catalogue stubs used by unit tests & later modules (group 3 / 5)
// ---------------------------------------------------------------------------

model NewsArticle {
  id    Int      @id @default(autoincrement())
  locale         String    @default("fr")
  slug           String
  title          String
  category       String?
  classification String?
  sujet          String?
  /** Nom libre, conservé pour les articles repris sans fiche auteur. */
  authorName     String?
  authorId    Int?
  author         Author?   @relation(fields: [authorId], references: [id])
  date           DateTime?
  publicationDate DateTime?
  readTime       String?
  shortDesc      String?   @db.Text
  fullContent    String?   @db.Text
  image          String?
  tags           Json?
  status         String    @default("draft")
  publishedAt    DateTime?
  legacyId       String?
  parentId       Int?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([slug, locale])
  @@index([status, date])
  @@index([authorId])
  @@index([legacyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("news_articles")
}

model EventItem {
  id    Int      @id @default(autoincrement())
  locale      String    @default("fr")
  slug        String
  title       String
  type        String?
  category    String?
  targetAudience String?
  date        DateTime?
  startDate   DateTime?
  endDate     DateTime?
  location    String?
  shortDesc   String?   @db.Text
  fullContent String?   @db.Text
  image       String?
  agenda      Json?
  status      String    @default("draft")
  publishedAt DateTime?
  legacyId    String?
  parentId    Int?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([slug, locale])
  @@index([date])
  @@index([startDate])
  @@index([legacyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("events")
}

model Product {
  id    Int      @id @default(autoincrement())
  locale       String    @default("fr")
  slug         String
  name         String
  category     String?
  sku          String?
  price        String?
  shortDesc    String?   @db.Text
  fullDesc     String?   @db.Text
  image        String?
  gallery      Json?
  inStock      Boolean   @default(true)
  stockQty     Int?
  stockFinal   Boolean   @default(false)
  currency     String?
  sortOrder    Int       @default(0)
  deliveryTime String?
  features     Json?
  specs        Json?
  options      Json?
  catalogPdf   String?
  legacyId     String?
  parentId     Int?
  isDefault    Boolean   @default(false)
  status       String    @default("draft")
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([slug, locale])
  @@index([category, inStock])
  @@index([legacyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Catalogue — group 3 (services, partners, careers, solutions, hero)
// ---------------------------------------------------------------------------

model ServiceItem {
  id    Int      @id @default(autoincrement())
  locale    String    @default("fr")
  slug      String
  title     String
  icon      String?
  color     String?
  image     String?
  shortDesc String?   @db.Text
  fullDesc  String?   @db.Text
  features  Json?
  faq       Json?
  sortOrder Int       @default(0)
  legacyId  String?
  parentId  Int?
  isDefault Boolean   @default(false)
  status    String    @default("draft")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([slug, locale])
  @@index([status])
  @@index([legacyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("services")
}

model Partner {
  id    Int      @id @default(autoincrement())
  locale    String    @default("fr")
  slug      String
  name      String
  logo      String?
  category  String?
  website   String?
  sortOrder Int       @default(0)
  legacyId  String?
  parentId  Int?
  isDefault Boolean   @default(false)
  status    String    @default("draft")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([slug, locale])
  @@index([locale, status])
  @@index([legacyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("partners")
}

model Career {
  id    Int      @id @default(autoincrement())
  locale      String    @default("fr")
  slug        String
  title       String
  type        String?
  location    String?
  salary      String?
  shortDesc   String?   @db.Text
  fullDesc    String?   @db.Text
  image       String?
  typeTravail String?
  mission     String?   @db.Text
  objectifs   Json?
  prerequis   Json?
  experience  String?
  workflow    Json?
  benefits    Json?
  contact     String?
  legacyId    String?
  parentId    Int?
  isDefault   Boolean   @default(false)
  status      String    @default("draft")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  updatedBy   Int?

  applications JobApplication[]

  @@unique([slug, locale])
  @@index([status, location])
  @@index([legacyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("careers")
}

model SolutionCategory {
  id    Int      @id @default(autoincrement())
  locale     String    @default("fr")
  slug       String
  title      String
  shortDesc  String?   @db.Text
  fullDesc   String?   @db.Text
  icon       String?
  image      String?
  color      String?
  productIds Json?
  features   Json?
  faq        Json?
  sortOrder  Int       @default(0)
  legacyId   String?
  parentId   Int?
  isDefault  Boolean   @default(false)
  status     String    @default("draft")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@unique([slug, locale])
  @@index([status])
  @@index([legacyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("solutions")
}

model HeroSlide {
  id    Int      @id @default(autoincrement())
  locale      String    @default("fr")
  title       String
  subtitle    String?
  description String?   @db.Text
  image       String?
  cta         String?
  ctaLink     String?
  sortOrder   Int       @default(0)
  legacyId    Int?
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@index([locale, status, sortOrder])
  @@index([deletedAt])
  @@map("hero_slides")
}

model Order {
  id          Int       @id @default(autoincrement())
  code        String?   @unique
  userId      Int?
  user        User?     @relation("UserOrders", fields: [userId], references: [id])
  client      String
  email       String
  phone       String?
  company     String?
  date        DateTime  @default(now())
  status      String    @default("pending")
  total       Decimal   @default(0) @db.Decimal(14, 2)
  cost        Decimal?  @db.Decimal(14, 2)
  currency    String    @default("DZD")
  items       Json?
  address     String?   @db.Text
  payment     String?
  paid        Boolean   @default(false)
  coupon      String?
  quoteId     Int?
  zone        String?
  ip          String?
  history     Json?
  invoice     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  updatedBy   Int?

  @@index([status, date])
  @@index([email])
  @@index([userId])
  @@index([deletedAt])
  @@map("orders")
}

model Quote {
  id           Int       @id @default(autoincrement())
  reference    String?   @unique
  userId       Int?
  user         User?     @relation("UserQuotes", fields: [userId], references: [id])
  client       String
  email        String
  phone        String?
  company      String?
  date         DateTime  @default(now())
  status       String    @default("submitted")
  total        Decimal   @default(0) @db.Decimal(14, 2)
  currency     String    @default("DZD")
  validity     String?
  items        Json?
  coupon       String?
  orderId      Int?
  zone         String?
  ip           String?
  history      Json?
  nature       String?
  natureOther  String?
  note         String?   @db.Text
  desiredDate  DateTime?
  address      String?   @db.Text
  country      String?
  attachments  Json?
  response     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    Int?
  updatedBy    Int?

  @@index([status, date])
  @@index([email])
  @@index([userId])
  @@index([deletedAt])
  @@map("quotes")
}

model JobApplication {
  id         Int       @id @default(autoincrement())
  reference  String?   @unique
  userId     Int?
  user       User?     @relation("UserApplications", fields: [userId], references: [id])
  careerId   Int?
  career     Career?   @relation(fields: [careerId], references: [id])
  candidate  String
  email      String
  phone      String?
  jobTitle   String?
  status     String    @default("new")
  date       DateTime  @default(now())
  experience String?
  motivation String?   @db.Text
  rating     Int?
  score      Int?
  note       String?   @db.Text
  cv         String?
  lm         String?
  history    Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy  Int?
  updatedBy  Int?

  @@index([status, date])
  @@index([email])
  @@index([userId])
  @@index([careerId])
  @@index([deletedAt])
  @@map("job_applications")
}

model Author {
  id          Int       @id @default(autoincrement())
  locale      String    @default("fr")
  slug        String?
  name        String
  email       String?
  /** Qualification affichée sous le nom sur la fiche article. */
  role        String?
  /** Résumé de présentation affiché dans le bloc « À propos de l'auteur ». */
  bio         String?   @db.Text
  photo       String?
  /**
   * Auteur retenu quand un article n'en désigne aucun. Un seul à la fois :
   * le service bascule les autres à false.
   */
  isFallback  Boolean   @default(false)
  sortOrder   Int       @default(0)
  status      String    @default("published")
  legacyId    String?
  parentId    Int?
  isDefault   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   Int?
  updatedBy   Int?

  articles    NewsArticle[]

  @@unique([slug, locale])
  @@index([status, sortOrder])
  @@index([isFallback])
  @@index([legacyId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("authors")
}
