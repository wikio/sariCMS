# =============================================================================
# SARI CMS — Backend environment
# Copy to .env and adjust. Never commit secrets.
# =============================================================================

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Public origin of the Next.js frontend (CORS). Comma-separated list allowed.
CORS_ORIGINS=http://localhost:5000,http://localhost:3000

# -----------------------------------------------------------------------------
# Database driver
#   mysql      → Prisma + MySQL      (default production)
#   postgres   → Prisma + PostgreSQL
#   mongodb    → Mongoose
#   json       → file-based JSON adapter (demo / shared hosting without SQL)
# -----------------------------------------------------------------------------
DB_DRIVER=json

# Used when DB_DRIVER=mysql | postgres
# MySQL     : mysql://USER:PASS@HOST:3306/sari_cms
# PostgreSQL: postgresql://USER:PASS@HOST:5432/sari_cms
# Schéma + données de démarrage (contexte algérien) : voir backend/sql/
DATABASE_URL="mysql://sari:sari@127.0.0.1:3306/sari_cms"

# Used when DB_DRIVER=mongodb
MONGODB_URI="mongodb://127.0.0.1:27017/sari_cms"

# Used when DB_DRIVER=json
JSON_STORE_PATH=./storage/json

# Catalogue vitrine à importer (data/{fr,en,ar}/*.json)
CATALOG_JSON_PATH=../data

# -----------------------------------------------------------------------------
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# -----------------------------------------------------------------------------
# Cache (memory L1 + Keyv file/SQLite L2 — no Redis)
# -----------------------------------------------------------------------------
CACHE_TTL_SECONDS=60
CACHE_L2_PATH=./storage/cache/keyv.json
# Optional native SQLite L2 (requires better-sqlite3). Leave empty to use file.
CACHE_SQLITE_PATH=

# -----------------------------------------------------------------------------
# Soft-delete / trash
# Items in the trash older than this (hours) are eligible for automatic purge.
# -----------------------------------------------------------------------------
TRASH_RETENTION_HOURS=720
TRASH_PURGE_CRON=0 3 * * *
PURGE_CONFIRM_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Seed (structure only — no real catalogue content)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@sarisysteme.com
SEED_ADMIN_PASSWORD=ChangeMe_Sari2026!

# -----------------------------------------------------------------------------
# Throttling
# -----------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=10

# -----------------------------------------------------------------------------
# i18n
# -----------------------------------------------------------------------------
FALLBACK_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en,ar

# -----------------------------------------------------------------------------
# SMTP / Emails
# Laissez SMTP_HOST vide pour le mode « fichier » (outbox JSON, sans envoi réel).
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SARI Système <noreply@sarisysteme.com>"
