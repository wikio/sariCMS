{
  "name": "sari-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "merge:translations": "node scripts/merge-translations.mjs",
    "intl:check": "node scripts/check-translations.mjs",
    "intl:sync": "node scripts/intl-sync.mjs",
    "intl:test": "node scripts/test-intl-tree.mjs && node --experimental-strip-types scripts/test-admin-i18n.mjs",
    "intl:warn": "node scripts/check-translations.mjs --warn",
    "dev": "npm run intl:warn && next dev -p 5000",
    "prebuild": "npm run merge:translations",
    "predev": "npm run merge:translations",
    "build": "npm run intl:check && npm run builder:check && next build --webpack",
    "admin-auth:test": "node scripts/test-access-control.mjs && node --test scripts/test-admin-login.mjs",
    "prod:smoke": "node scripts/smoke-production.mjs",
    "start": "next start",
    "lint": "eslint app components contexts i18n lib proxy.ts next.config.mjs",
    "news:test": "node --test scripts/test-news-groups.mjs && node scripts/test-menu-auto.mjs",
    "menus:check": "node scripts/check-menus.mjs",
    "menus:sync": "node scripts/sync-menus.mjs",
    "visibility:test": "node scripts/test-visibility.mjs",
    "routes:check": "node scripts/check-routes.mjs",
    "quote:test": "node scripts/test-quote-checkout.mjs && node --test scripts/test-cart.mjs",
    "users:test": "node scripts/test-user-admin.mjs && node --test scripts/test-user-form.mjs",
    "front-auth:test": "node --test scripts/test-front-auth.mjs",
    "users:seed": "node scripts/seed-test-users.mjs",
    "builder:check": "node scripts/check-builder-kit.mjs",
    "links:test": "node scripts/test-link-kind.mjs",
    "shop:test": "node --experimental-strip-types scripts/test-shop-sync.mjs",
    "settings-doc:test": "node scripts/test-settings-doc.mjs",
    "social-card:test": "node --experimental-default-type=module scripts/test-social-card.mjs",
    "payments:test": "node --experimental-strip-types scripts/test-payment-records.mjs",
    "storage:audit": "node scripts/test-storage-map.mjs",
    "upload:test": "node scripts/test-upload-hardening.mjs",
    "contact:test": "node --test scripts/test-contact-routing.mjs scripts/test-contact-ui.mjs && npm --prefix backend test -- --runInBand contact-triage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@napi-rs/canvas": "^1.2.1",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "date-fns": "^4.4.0",
    "fabric": "^6.9.1",
    "grapesjs": "^0.22.14",
    "lucide-react": "^1.28.0",
    "next": "16.3.5",
    "next-intl": "^4.13.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
