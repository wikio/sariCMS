[Unit]
Description=sariCMS — API NestJS
After=network-online.target mysql.service
Wants=network-online.target

[Service]
User=saricms
Group=saricms
WorkingDirectory=/srv/saricms/current/backend
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/saricms/api.env
ExecStart=/usr/bin/env node dist/main.js
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/saricms/shared/backend/storage /srv/saricms/shared/public/uploads /srv/saricms/shared/public/canvas

[Install]
WantedBy=multi-user.target
